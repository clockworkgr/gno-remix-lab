{
  "schemaVersion": 1,
  "id": "club-poll",
  "version": "1.0.0",
  "title": "Club poll",
  "summary": "A club whose members vote in single-choice polls. Each poll freezes its electorate when it opens.",
  "components": [
    {
      "id": "ballots",
      "version": "1.0.0"
    },
    {
      "id": "core",
      "version": "1.0.0"
    },
    {
      "id": "membership",
      "version": "1.0.0"
    },
    {
      "id": "policies",
      "version": "1.0.0"
    },
    {
      "id": "render",
      "version": "1.0.0"
    }
  ],
  "operations": [
    {
      "op": "members.invite",
      "description": "Invite an address to join (invitation mode only)",
      "default": "owner",
      "floor": "reviewer"
    },
    {
      "op": "members.remove",
      "description": "Remove a member",
      "default": "owner",
      "floor": "owner"
    },
    {
      "op": "members.set_role",
      "description": "Change a member role, including appointing owners",
      "default": "owner",
      "floor": "owner"
    },
    {
      "op": "poll.create",
      "description": "Create a draft poll",
      "default": "owner",
      "floor": "reviewer"
    },
    {
      "op": "poll.open",
      "description": "Open a poll, freezing its options and electorate",
      "default": "owner",
      "floor": "reviewer"
    },
    {
      "op": "policy.set",
      "description": "Change these rules within their floors",
      "default": "owner",
      "floor": "owner"
    }
  ],
  "lifecycle": "draft"
}
